FIREBASE_PROJECT_ID=todoapp-dev
# Optional for local development. In Cloud Run, prefer Application Default
# Credentials on a service account that can mint Firebase custom tokens.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional for direct Cloud Run calls. Same-origin Firebase Hosting rewrites do
# not need CORS.
AUTH_WEB_ORIGINS=https://auth.example.com,https://app.example.com
# Firestore-backed hosted auth exchange codes are single-use and short-lived.
AUTH_EXCHANGE_CODE_COLLECTION=authExchangeCodes
# Defaults to 120 seconds and is clamped between 15 seconds and 5 minutes.
AUTH_EXCHANGE_CODE_TTL_MS=120000
# Per-instance fixed-window rate limits for hosted broker endpoints.
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_EXCHANGE_RATE_LIMIT=20
AUTH_SESSION_RATE_LIMIT=30
PORT=8080
