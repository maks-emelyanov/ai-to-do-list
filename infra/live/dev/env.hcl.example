locals {
  env = "dev"
  google_auth_provider_client_id = trimspace(
    get_env(
      "GOOGLE_AUTH_PROVIDER_CLIENT_ID",
      run_cmd(
        "--terragrunt-quiet",
        "bash",
        "${get_terragrunt_dir()}/../../scripts/gcp-secret-access.sh",
        "todoapp-dev-REPLACE_ME",
        "google-auth-provider-client-id"
      )
    )
  )
  google_auth_provider_client_secret = trimspace(
    get_env(
      "GOOGLE_AUTH_PROVIDER_CLIENT_SECRET",
      run_cmd(
        "--terragrunt-quiet",
        "bash",
        "${get_terragrunt_dir()}/../../scripts/gcp-secret-access.sh",
        "todoapp-dev-REPLACE_ME",
        "google-auth-provider-client-secret"
      )
    )
  )
  enable_microsoft_auth_provider = get_env("ENABLE_MICROSOFT_AUTH_PROVIDER", "false") == "true"
  microsoft_auth_provider_client_id = local.enable_microsoft_auth_provider ? trimspace(
    get_env(
      "MICROSOFT_AUTH_PROVIDER_CLIENT_ID",
      run_cmd(
        "--terragrunt-quiet",
        "bash",
        "${get_terragrunt_dir()}/../../scripts/gcp-secret-access.sh",
        "todoapp-dev-REPLACE_ME",
        "microsoft-auth-provider-client-id"
      )
    )
  ) : ""
  microsoft_auth_provider_client_secret = local.enable_microsoft_auth_provider ? trimspace(
    get_env(
      "MICROSOFT_AUTH_PROVIDER_CLIENT_SECRET",
      run_cmd(
        "--terragrunt-quiet",
        "bash",
        "${get_terragrunt_dir()}/../../scripts/gcp-secret-access.sh",
        "todoapp-dev-REPLACE_ME",
        "microsoft-auth-provider-client-secret"
      )
    )
  ) : ""

  local_android_sha1_hashes   = []
  local_android_sha256_hashes = []

  eas_android_sha1_hashes = compact([
    for hash in split(",", get_env("EAS_ANDROID_SHA1_HASHES", "")) :
    lower(replace(trimspace(hash), ":", ""))
  ])

  eas_android_sha256_hashes = compact([
    for hash in split(",", get_env("EAS_ANDROID_SHA256_HASHES", "")) :
    lower(replace(trimspace(hash), ":", ""))
  ])

  enable_apple_auth_provider = get_env("ENABLE_APPLE_AUTH_PROVIDER", "false") == "true"

  inputs = {
    create_project  = true
    project_id      = "todoapp-dev-REPLACE_ME"
    project_name    = "Todo App Dev"
    billing_account = "000000-000000-000000"

    # Use one of these when create_project is true.
    folder_id = null
    org_id    = null

    # Regional infrastructure is standardized in infra/live/dev/terragrunt.hcl
    # and the module validates that only us-east1 is used.

    firebase_web_app_display_name = "Todo App Dev"

    enable_email_sign_in     = true
    email_password_required  = false
    enable_anonymous_sign_in = false
    enable_phone_sign_in     = false
    allow_duplicate_emails   = false
    google_auth_provider = {
      enabled       = get_env("ENABLE_GOOGLE_AUTH_PROVIDER", "true") == "true"
      client_id     = local.google_auth_provider_client_id
      client_secret = local.google_auth_provider_client_secret
    }
    apple_auth_provider = {
      enabled       = local.enable_apple_auth_provider
      client_id     = get_env("APPLE_AUTH_PROVIDER_SERVICES_ID", "")
      client_secret = local.enable_apple_auth_provider ? run_cmd("--terragrunt-quiet", "node", "${get_terragrunt_dir()}/../../scripts/apple-client-secret.mjs") : ""
    }
    microsoft_auth_provider = {
      enabled       = local.enable_microsoft_auth_provider
      client_id     = local.microsoft_auth_provider_client_id
      client_secret = local.microsoft_auth_provider_client_secret
    }
    authorized_domains = [
      "localhost",
      "todoapp-dev-REPLACE_ME.firebaseapp.com",
      "todoapp-dev-REPLACE_ME.web.app",
    ]

    # Set these once app IDs are finalized and you want Firebase native app registrations.
    create_android_app       = false
    android_package_name     = "com.example.todoapp"
    android_app_display_name = "Todo App Dev Android"
    android_sha1_hashes      = distinct(concat(local.local_android_sha1_hashes, local.eas_android_sha1_hashes))
    android_sha256_hashes    = distinct(concat(local.local_android_sha256_hashes, local.eas_android_sha256_hashes))

    create_apple_app       = false
    apple_bundle_id        = "com.example.todoapp"
    apple_app_display_name = "Todo App Dev iOS"
  }
}
